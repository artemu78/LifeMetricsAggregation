{
  "name": "live-life-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:types": "openapi-typescript openapi.yaml -o web/src/generated/api-types.ts",
    "check:types": "npm run generate:types && git diff --exit-code -- web/src/generated/api-types.ts"
  },
  "dependencies": {
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
