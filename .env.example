# Copy this file to .env and fill the values locally.
# Never paste these tokens into chat or commit .env.
RESCUETIME_API_KEY=
TODOIST_API_TOKEN=

# Google OAuth JSON paths (relative to this project, absolute, or ~/ paths).
# Actual secrets stay in these ignored JSON files; do not paste them here.
GOOGLE_DRIVE_CLIENT_SECRET_FILE=private/google-drive-client-secret.json
GOOGLE_DRIVE_TOKEN_FILE=data/google-drive-token.json

# Google Drive fitness folder and Google Doc diary IDs.
GOOGLE_DRIVE_FOLDER_ID=
DIARY_GOOGLE_DOC_ID=

# Local source inputs and downloaded Google Drive exports.
# SOURCE_INBOX_DIR contains health/, health_connect/, and diary/ subfolders.
SOURCE_INBOX_DIR=data/inbox
GOOGLE_DRIVE_CACHE_DIR=data/inbox/fitness_drive
WELLTORY_DOWNLOADS_DIR=~/Downloads
WELLTORY_FILE_PATTERN=WELLTORY_HRV_DATA_EXPORT_*.csv

# Optional API endpoint overrides; blank values use these official defaults.
RESCUETIME_API_URL=https://www.rescuetime.com/anapi/data
TODOIST_API_BASE_URL=https://api.todoist.com/api/v1
